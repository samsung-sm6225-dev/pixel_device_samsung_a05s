type vendor_fingerprint_service, service_manager_type;

allow vendor_fingerprint_service default_prop:property_service { set };
allow vendor_fingerprint_service system_prop:property_service { set };
allow vendor_fingerprint_service vendor_fingerprint_prop:property_service { set };

allow vendor_fingerprint_service vendor_goodix_fp_device:chr_file { read write open ioctl };
