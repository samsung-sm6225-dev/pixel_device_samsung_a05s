type vendor_rild, domain;
type vendor_rild_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(vendor_rild)

allow vendor_rild radio_device:chr_file rw_file_perms;
allow vendor_rild system_file:file execute_no_trans;
allow vendor_rild vendor_file:file execute_no_trans;
allow vendor_rild hal_radio_hwservice:hwservice_manager find;
allow vendor_rild hal_radio_server:binder call;
allow vendor_rild hal_radio_hwservice:hwservice_manager add;
allow vendor_rild radio_prop:property_service set;
allow vendor_rild system_prop:property_service set;
allow vendor_rild vendor_radio_prop:property_service set;
