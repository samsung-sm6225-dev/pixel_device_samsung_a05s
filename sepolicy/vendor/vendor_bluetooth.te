type vendor_bluetooth, domain;
type vendor_bluetooth_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(vendor_bluetooth)

allow vendor_bluetooth bluetooth_device:chr_file rw_file_perms;
allow vendor_bluetooth system_file:file execute_no_trans;
allow vendor_bluetooth vendor_file:file execute_no_trans;
allow vendor_bluetooth hal_bluetooth_hwservice:hwservice_manager find;
allow vendor_bluetooth hal_bluetooth_server:binder call;
allow vendor_bluetooth hal_bluetooth_hwservice:hwservice_manager add;
allow vendor_bluetooth bluetooth_prop:property_service set;
allow vendor_bluetooth system_prop:property_service set;
allow vendor_bluetooth vendor_bluetooth_prop:property_service set;
