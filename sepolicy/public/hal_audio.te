type hal_audio_default, domain;
type hal_audio_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_audio_default)

allow hal_audio_default audio_device:chr_file rw_file_perms;
allow hal_audio_default system_file:file execute_no_trans;
allow hal_audio_default vendor_file:file execute_no_trans;
allow hal_audio_default hal_audio_hwservice:hwservice_manager find;
allow hal_audio_default hal_audio_server:binder call;
allow hal_audio_default hal_audio_hwservice:hwservice_manager add;
allow hal_audio_default audio_prop:property_service set;
allow hal_audio_default system_prop:property_service set;
allow allow hal_audio_default vendor_audio_prop:property_service set;
