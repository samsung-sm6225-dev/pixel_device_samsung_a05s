type hal_display_default, domain;
type hal_display_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_display_default)

allow hal_display_default display_device:chr_file rw_file_perms;
allow hal_display_default system_file:file execute_no_trans;
allow hal_display_default vendor_file:file execute_no_trans;
allow hal_display_default hal_display_hwservice:hwservice_manager find;
allow hal_display_default hal_display_server:binder call;
allow hal_display_default hal_display_hwservice:hwservice_manager add;
allow hal_display_default display_prop:property_service set;
allow hal_display_default system_prop:property_service set;
allow hal_display_default vendor_display_prop:property_service set;
