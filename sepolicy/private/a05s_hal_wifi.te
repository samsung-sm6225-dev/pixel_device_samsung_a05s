allow hal_wifi_default self:capability { sys_nice };
allow hal_wifi_default wifi_device:chr_file { read write open ioctl };
allow hal_wifi_default system_server:binder { call };
allow hal_wifi_default vendor_wifi_prop:property_service { set };
