allow hal_audio_default audio_device:chr_file { read write open ioctl };
allow hal_audio_default system_server:binder { call };
allow hal_audio_default mediaserver:binder { call };
allow hal_audio_default servicemanager:binder { call };
allow hal_audio_default surfaceflinger:binder { call };
allow hal_audio_default audioserver:binder { call };
allow hal_audio_default rild:binder { call };
allow hal_audio_default vendor_audio_prop:property_service { set };
